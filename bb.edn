{:deps  {com.github.franks42/cedn    {:mvn/version "1.6.1"}
         com.github.franks42/uuidv7  {:mvn/version "0.7.3"}
         ;; the default backend's libsodium binding (must match deps.edn)
         com.github.franks42/nacljc  {:mvn/version "0.6.0"}}

 :paths ["src" "test"]

 :tasks
 {:requires ([clojure.test :as t])

  smoke
  {:doc  "Run the babashka compatibility smoke test suite on the JCA backend
          (asked for explicitly). Catches regressions in code paths that
          work on JVM but fail on bb (typically proxy [SecureRandom] via
          the seed->public-key derivation path)."
   ;; a subprocess: the backend is read once, when signet.impl loads
   :task (shell {:extra-env {"SIGNET_BACKEND" "jca"}}
                "bb" "-e" (str "(require 'clojure.test 'signet.bb-smoke-test)"
                               "(let [r (clojure.test/run-tests 'signet.bb-smoke-test)]"
                               "  (System/exit (if (pos? (+ (:fail r 0) (:error r 0))) 1 0)))"))}

  test:jvm
  {:doc  "Full test suite on the JVM, JCA backend (asked for explicitly; no native libsodium needed)"
   :task (shell "clojure" "-M:test:jca")}

  test:jvm-sodium
  {:doc  "Full test suite on the JVM, libsodium backend (needs libsodium >= 1.0.19 and JDK 25+; nacljc comes from Clojars)"
   :task (do (shell "clojure" "-M:test:sodium")
             (shell "clojure" "-Sdeps" "{:aliases {:t {:extra-paths [\"test\"]}}}"
                    "-M:t:sodium" "-m" "signet.backend-parity" "sodium"))}

  test:bb-sodium
  {:doc  "Full test suite on babashka, libsodium backend (all but secp256k1)"
   ;; A subprocess with no backend set: this checks the default. nacljc
   ;; comes from this bb.edn's :deps. Its pom's org.babashka/ffi dependency
   ;; is ignored by bb, which always uses its built-in babashka.ffi. No
   ;; parity run here: its JCA oracle cannot derive keys from seeds on bb.
   :task (shell {:extra-env {"SIGNET_BACKEND" ""}}
                "bb" "-e" "(require 'signet.suite) (signet.suite/-main \"sodium\")")}

  test:fail-closed
  {:doc  "Without libsodium the default backend fails at load, naming the JCA opt-in; it never falls back"
   :task (let [r (shell {:continue true :out :string :err :string
                         :extra-env {"SIGNET_BACKEND" "" "NACLJC_LIBSODIUM" "/nonexistent/libsodium.dylib"}}
                        "bb" "-e" "(require 'signet.impl) (println :loaded signet.impl/backend)")
               out (str (:out r) (:err r))]
           (if (and (pos? (:exit r))
                    (not (clojure.string/includes? out ":loaded"))
                    (clojure.string/includes? out "signet.backend=jca"))
             (println "test:fail-closed: refused to load without libsodium, and named the JCA opt-in")
             (do (println "test:fail-closed FAILED:\n" out) (System/exit 1))))}

  test:no-sodium
  {:doc  "Everything that needs no native libsodium: lint, fmt, JCA suite, bb smoke"
   :task (do (run 'lint) (run 'fmt) (run 'test:jvm) (run 'smoke))}

  test:all
  {:doc  "Everything: test:no-sodium plus the libsodium backend on the JVM (with parity) and on bb. Needs libsodium >= 1.0.19"
   :task (do (run 'test:no-sodium) (run 'test:jvm-sodium) (run 'test:bb-sodium) (run 'test:fail-closed))}

  test:jar
  {:doc  "Install signet's jar locally, then run signet's own tests against the jar from a scratch consumer (tests only, no src): JVM jca, JVM sodium + parity, bb sodium. Refuses a version already on Clojars."
   :task (do (run 'check-not-released)
             (shell "clojure" "-P")
             (shell "clojure" "-T:build" "install")
             (shell "bb" "-cp" "test" "-m" "signet.consumer-check" "local"))}

  test:clojars
  {:doc  "Run signet's own tests against a release fetched from Clojars (empty local repo): JVM jca, JVM sodium + parity, bb sodium. Arg: version"
   :task (apply shell "bb" "-cp" "test" "-m" "signet.consumer-check" "clojars" *command-line-args*)}

  check-not-released
  {:doc  "Fail if build.clj's version is already published on Clojars: installing it locally would shadow the real jar in ~/.m2"
   :task (let [ver (second (re-find (re-pattern "\\(def version \"([^\"]+)\"\\)") (slurp "build.clj")))
               url (str "https://repo.clojars.org/com/github/franks42/signet/" ver "/signet-" ver ".pom")
               published? (zero? (:exit (shell {:continue true :out :string :err :string} "curl" "-sfI" url)))]
           ;; Refuse to install a released version: the local build would shadow the
           ;; published jar in ~/.m2 (it happened once, 2026-09-23, right after a release).
           (when published?
             (println "ERROR: signet" ver "is already on Clojars; bump build.clj to the next -SNAPSHOT before installing")
             (System/exit 1)))}

  release-check
  {:doc  "Refuse to release unless build.clj's version is a plain X.Y.Z and CHANGELOG.md has a section for it"
   :task (let [ver  (second (re-find (re-pattern "\\(def version \"([^\"]+)\"\\)") (slurp "build.clj")))
               fail (fn [& msg] (apply println "ERROR:" msg) (System/exit 1))]
           (cond
             (nil? ver) (fail "cannot parse the version from build.clj")
             (not (re-matches (re-pattern "\\d+\\.\\d+\\.\\d+") ver))
             (fail "version" (pr-str ver) "is not a stable X.Y.Z")
             ;; a dated heading, "## X.Y.Z (YYYY-MM-DD)": "(unreleased)" is refused
             (not (re-find (re-pattern (str "(?m)^## " (java.util.regex.Pattern/quote ver)
                                            " \\(\\d{4}-\\d{2}-\\d{2}\\)"))
                           (slurp "CHANGELOG.md")))
             (fail (str "CHANGELOG.md has no dated \"## " ver " (YYYY-MM-DD)\" section"))
             :else (println "release-check: version" ver "is releasable")))}

  lint
  {:doc  "clj-kondo on every Clojure file (config: :clj branch only, see .clj-kondo/config.edn)"
   :task (shell "clj-kondo" "--lint" "src" "test" "build.clj" "bb.edn" "deps.edn")}

  fmt
  {:doc  "cljfmt check on every Clojure file"
   :task (shell "cljfmt" "check" "src" "test" "build.clj" "bb.edn" "deps.edn")}

  fmt:fix
  {:doc  "cljfmt fix on every Clojure file"
   :task (shell "cljfmt" "fix" "src" "test" "build.clj" "bb.edn" "deps.edn")}

  md
  {:doc  "Check markdown against editmd's style (scripts/mdfmt.clj): lists files that would change, exits 1 if any. Args: files (default: every tracked .md)"
   :task (let [files (or (seq *command-line-args*)
                         (remove clojure.string/blank?
                                 (clojure.string/split-lines
                                  (:out (shell {:out :string} "git" "ls-files" "*.md")))))]
           (apply shell "bb" "scripts/mdfmt.clj" files))}

  md:fix
  {:doc  "Format markdown to editmd's style in place (scripts/mdfmt.clj). Args: files (default: every tracked .md)"
   :task (let [files (or (seq *command-line-args*)
                         (remove clojure.string/blank?
                                 (clojure.string/split-lines
                                  (:out (shell {:out :string} "git" "ls-files" "*.md")))))]
           (apply shell "bb" "scripts/mdfmt.clj" "--write" files))}

  verify
  {:doc  "Verify an ECDSA / Ed25519 signature. secp256k1 verification
          shells out to JVM Clojure (BouncyCastle) since BC isn't
          loadable inside bb itself.

          Usage:
            bb verify [--curve secp256k1|ed25519]
                      --pubkey   <hex>
                      --message  <hex|@file>
                      --signature <hex|@file>

          Exit code: 0 = valid, 1 = invalid, 2 = bad args."
   :task (apply shell "clojure" "-M" "-m" "signet.cli.verify"
                *command-line-args*)}}}
