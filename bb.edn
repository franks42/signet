{:deps  {com.github.franks42/cedn    {:mvn/version "1.5.2"}
         com.github.franks42/uuidv7  {:mvn/version "0.7.1"}}

 :paths ["src" "test"]

 :tasks
 {:requires ([clojure.test :as t])

  smoke
  {:doc  "Run the babashka compatibility smoke test suite.
          Catches regressions in code paths that work on JVM but
          fail on bb (typically proxy [SecureRandom] via the
          seed->public-key derivation path)."
   :requires ([signet.bb-smoke-test])
   :task (let [r (t/run-tests 'signet.bb-smoke-test)]
           (when (pos? (+ (:fail r 0) (:error r 0)))
             (System/exit 1)))}

  test:jvm
  {:doc  "Full test suite on the JVM, JCA backend (default)"
   :task (shell "clojure" "-M:test")}

  test:jvm-sodium
  {:doc  "Full test suite on the JVM, libsodium backend (needs libsodium >= 1.0.19, JDK 25+, and the sodium.cljc snapshot: bb install in ../sodium.cljc)"
   :task (do (shell "clojure" "-M:test:sodium")
             (shell "clojure" "-Sdeps" "{:aliases {:t {:extra-paths [\"test\"]}}}"
                    "-M:t:sodium" "-m" "signet.backend-parity" "sodium"))}

  test:bb-sodium
  {:doc  "Full test suite on babashka, libsodium backend (all but secp256k1)"
   ;; A subprocess keeps this bb.edn's :paths and :deps; -cp would replace
   ;; them. sodium.cljc comes from the local snapshot jar (bb install in
   ;; ../sodium.cljc) via add-deps. Its pom's org.babashka/ffi dependency is
   ;; ignored by bb, which always uses its built-in babashka.ffi. No parity
   ;; run here: its JCA oracle cannot derive keys from seeds on bb.
   :task (shell {:extra-env {"SIGNET_BACKEND" "sodium"}}
                "bb" "-e" (str "(babashka.deps/add-deps '{:deps {com.github.franks42/sodium {:mvn/version \"0.1.0-SNAPSHOT\"}}})"
                               "(require 'signet.suite) (signet.suite/-main \"sodium\")"))}

  sodium:install
  {:doc  "Build and install the sodium.cljc snapshot (com.github.franks42/sodium 0.1.0-SNAPSHOT) into ~/.m2 from a checkout. Arg: checkout dir (default ../sodium.cljc)"
   :task (let [dir (or (first *command-line-args*) "../sodium.cljc")]
           (shell {:dir dir} "clojure" "-T:build" "install"))}

  test:no-sodium
  {:doc  "Everything that needs no native libsodium: lint, fmt, JCA suite, bb smoke"
   :task (do (run 'lint) (run 'fmt) (run 'test:jvm) (run 'smoke))}

  test:all
  {:doc  "Everything: test:no-sodium plus the libsodium backend on the JVM (with parity) and on bb. Needs libsodium >= 1.0.19 and the sodium.cljc snapshot (bb sodium:install)"
   :task (do (run 'test:no-sodium) (run 'test:jvm-sodium) (run 'test:bb-sodium))}

  test:jar
  {:doc  "Install signet's jar locally, then run signet's own tests against the jar from a scratch consumer (tests only, no src): JVM jca, JVM sodium + parity, bb sodium"
   :requires ([babashka.fs :as fs])
   :task (let [_       (shell "clojure" "-T:build" "install")
               version (second (re-find (re-pattern "\\(def version \"([^\"]+)\"\\)") (slurp "build.clj")))
               tests   (str (fs/absolutize "test"))
               dir     (str (fs/create-temp-dir {:prefix "signet-consumer-"}))
               coord   (str "com.github.franks42/signet {:mvn/version \"" version "\"}")
               sodium  "com.github.franks42/sodium {:mvn/version \"0.1.0-SNAPSHOT\"}"]
           (spit (str dir "/deps.edn")
                 (str "{:paths [\"" tests "\"] :deps {" coord "}"
                      " :aliases {:sodium {:extra-deps {" sodium "}"
                      " :jvm-opts [\"--enable-native-access=ALL-UNNAMED\" \"-Dsignet.backend=sodium\"]}}}"))
           (try
             (let [from-jar? (fn [out] (re-find (re-pattern "signet-from jar:file:") out))
                   where "(println :signet-from (str (clojure.java.io/resource \"signet/key.cljc\")))"
                   jvm-src (:out (shell {:dir dir :out :string} "clojure" "-M" "-e" where))]
               (when-not (from-jar? jvm-src)
                 (println "ERROR: signet did not load from the jar:" jvm-src) (System/exit 1))
               (println "signet loads from the installed jar" version)
               (shell {:dir dir} "clojure" "-M" "-m" "signet.suite" "jca")
               (shell {:dir dir} "clojure" "-M:sodium" "-m" "signet.suite" "sodium")
               (shell {:dir dir} "clojure" "-M:sodium" "-m" "signet.backend-parity" "sodium")
               (shell {:dir dir :extra-env {"SIGNET_BACKEND" "sodium"}}
                      "bb" "-e" (str "(babashka.deps/add-deps '{:deps {" coord " " sodium "}})"
                                     "(babashka.classpath/add-classpath \"" tests "\")"
                                     "(require 'signet.suite) (signet.suite/-main \"sodium\")")))
             (finally (fs/delete-tree dir))))}

  lint
  {:doc  "clj-kondo on every Clojure file (config: :clj branch only, see .clj-kondo/config.edn)"
   :task (shell "clj-kondo" "--lint" "src" "test" "build.clj" "bb.edn" "deps.edn")}

  fmt
  {:doc  "cljfmt check on every Clojure file"
   :task (shell "cljfmt" "check" "src" "test" "build.clj" "bb.edn" "deps.edn")}

  fmt:fix
  {:doc  "cljfmt fix on every Clojure file"
   :task (shell "cljfmt" "fix" "src" "test" "build.clj" "bb.edn" "deps.edn")}

  verify
  {:doc  "Verify an ECDSA / Ed25519 signature. secp256k1 verification
          shells out to JVM Clojure (BouncyCastle) since BC isn't
          loadable inside bb itself.

          Usage:
            bb verify [--curve secp256k1|ed25519]
                      --pubkey   <hex>
                      --message  <hex|@file>
                      --signature <hex|@file>

          Exit code: 0 = valid, 1 = invalid, 2 = bad args."
   :task (apply shell "clojure" "-M" "-m" "signet.cli.verify"
                *command-line-args*)}}}
