{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        com.github.franks42/cedn {:mvn/version "1.6.0"}
        com.github.franks42/uuidv7 {:mvn/version "0.7.2"}
        ;; BouncyCastle for secp256k1 ECDSA. Required only on the JVM
        ;; side — bb's SCI class allowlist excludes BC, so signet's
        ;; secp256k1 paths (signet.impl.jvm-secp256k1) are JVM-only.
        org.bouncycastle/bcprov-jdk18on {:mvn/version "1.86"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; libsodium backend (signet.impl.sodium), through nacljc from Clojars.
  ;; Needs libsodium >= 1.0.19 installed and JDK 25+. Use with :test, e.g.
  ;; clojure -M:test:sodium
  :sodium {:extra-deps {com.github.franks42/nacljc {:mvn/version "0.2.0"}}
           :jvm-opts   ["--enable-native-access=ALL-UNNAMED"
                        "-Dsignet.backend=sodium"]}

  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.6"}
                 slipset/deps-deploy {:mvn/version "0.2.2"}}
          :ns-default build}}}
